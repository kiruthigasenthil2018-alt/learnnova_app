# Copy this file to ".env" (same folder as package.json), fill in, then restart:  npx expo start -c --web
# See GOOGLE_LOGIN_SETUP.md for the 5-minute Google setup.

# Web (localhost) Google login — the only one you need to test in the browser
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Phone apps only (needs a development build)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Where the AI server runs (see server/server.js). Leave empty on a computer: http://localhost:3000 is used.
# On a real phone use your computer's Wi-Fi address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_AI_URL=
